<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="ShapeAppearance.FastColoc.Photo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="TextAppearance.FastColoc.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">@color/fc_plum</item>
        <item name="android:textSize">15sp</item>
    <item name="fontFamily">@font/dm_sans</item></style>
    <style name="TextAppearance.FastColoc.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/fc_plum</item>
        <item name="android:textSize">30sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    <item name="fontFamily">@font/baloo2</item></style>
    <style name="TextAppearance.FastColoc.Brand" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">29sp</item>
        <item name="android:textColor">@color/fc_plum</item>
        <item name="android:letterSpacing">-0.04</item>
    <item name="fontFamily">@font/baloo2</item></style>
    <style name="TextAppearance.FastColoc.Label" parent="TextAppearance.FastColoc.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.FastColoc.Supporting" parent="TextAppearance.FastColoc.Body">
        <item name="android:textColor">@color/fc_muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.FastColoc.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">50dp</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="cornerRadius">@dimen/fc_control_radius</item>
        <item name="backgroundTint">@color/fc_button_primary</item>
        <item name="android:textColor">@color/fc_white</item>
        <item name="iconTint">@color/fc_white</item>
        <item name="elevation">0dp</item>
    <item name="fontFamily">@font/dm_sans</item></style>
    <style name="Widget.FastColoc.Button.Coral" parent="Widget.FastColoc.Button">
        <item name="backgroundTint">@color/fc_button_coral</item>
        <item name="android:textColor">@color/fc_plum</item>
        <item name="iconTint">@color/fc_plum</item>
    </style>
    <style name="Widget.FastColoc.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/fc_touch_target</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/fc_control_radius</item>
        <item name="strokeColor">@color/fc_control_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/fc_control_background</item>
        <item name="android:textColor">@color/fc_violet</item>
        <item name="iconTint">@color/fc_violet</item>
    <item name="fontFamily">@font/dm_sans</item></style>
    <style name="Widget.FastColoc.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/fc_white</item>
        <item name="boxStrokeColor">@color/fc_control_stroke</item>
        <item name="boxStrokeErrorColor">@color/fc_error</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/fc_field_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/fc_field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/fc_field_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/fc_field_radius</item>
        <item name="endIconTint">@color/fc_violet</item>
        <item name="errorTextColor">@color/fc_error</item>
        <item name="android:textColorHint">@color/fc_muted</item>
    </style>
    <style name="Widget.FastColoc.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/fc_white</item>
        <item name="boxStrokeColor">@color/fc_control_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/fc_field_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/fc_field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/fc_field_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/fc_field_radius</item>
        <item name="endIconTint">@color/fc_violet</item>
    </style>
    <style name="Widget.FastColoc.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/fc_control_background</item>
        <item name="chipStrokeColor">@color/fc_control_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">24dp</item>
        <item name="chipMinHeight">44dp</item>
        <item name="android:textColor">@color/fc_violet_dark</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="checkedIconTint">@color/fc_violet</item>
    </style>
<style name="ShapeAppearance.FastColoc.DrawerItem" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">@dimen/fc_control_radius</item></style></resources>