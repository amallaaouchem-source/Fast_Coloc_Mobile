    <style name="TextAppearance.FastColoc.Section" parent="TextAppearance.FastColoc.Title">
        <item name="android:textSize">21sp</item><item name="android:lineSpacingExtra">0dp</item>
    </style>
    <style name="Widget.FastColoc.CompactButton" parent="Widget.FastColoc.Button.Outlined">
        <item name="android:textSize">13sp</item><item name="cornerRadius">14dp</item>
        <item name="android:paddingStart">12dp</item><item name="android:paddingEnd">12dp</item>
    </style>
    <style name="Widget.FastColoc.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/dm_sans</item><item name="fontFamily">@font/dm_sans</item>
