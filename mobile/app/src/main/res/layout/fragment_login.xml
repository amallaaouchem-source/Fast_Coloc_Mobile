<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/fc_background" android:scrollbars="none" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/fc_screen_padding">
        <include layout="@layout/include_fastcoloc_brand" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="16dp" android:background="@drawable/bg_fc_illustration">
            <ImageView android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center" android:rotation="-8" android:src="@drawable/ic_fastcoloc_symbol" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fc_content_de_te_revoir" android:textAppearance="@style/TextAppearance.FastColoc.Title" android:breakStrategy="balanced" android:layout_marginTop="18dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/fc_connecte_toi_a_ta_communaute" android:textAppearance="@style/TextAppearance.FastColoc.Supporting" android:textColor="@color/fc_muted" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/email" android:textAppearance="@style/TextAppearance.FastColoc.Label" android:layout_marginTop="18dp" android:layout_marginBottom="7dp" android:labelFor="@id/etLoginEmail" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilLoginEmail" style="@style/Widget.FastColoc.Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="@string/email">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etLoginEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:minHeight="50dp" android:textSize="15sp" android:textColor="@color/fc_plum" android:fontFamily="sans-serif" android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="14dp" android:paddingBottom="14dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/password" android:textAppearance="@style/TextAppearance.FastColoc.Label" android:layout_marginTop="18dp" android:layout_marginBottom="7dp" android:labelFor="@id/etLoginPassword" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilLoginPassword" style="@style/Widget.FastColoc.Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="@string/password" app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etLoginPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:minHeight="50dp" android:textSize="15sp" android:textColor="@color/fc_plum" android:fontFamily="sans-serif" android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="@string/fc_se_connecter" style="@style/Widget.FastColoc.Button" android:minHeight="48dp" android:textAllCaps="false" />
        <TextView android:id="@+id/tvLoginError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/fc_error" android:visibility="gone" android:background="@drawable/bg_fc_note" android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fc_nouveau_ici" android:textAppearance="@style/TextAppearance.FastColoc.Supporting" android:gravity="center" android:layout_marginTop="22dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenRegister" style="@style/Widget.FastColoc.Button.Outlined" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="@string/fc_creer_un_compte" android:minHeight="48dp" android:textAllCaps="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnGoogle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginTop="14dp" android:text="@string/s1_btnGoogle" style="@style/Widget.FastColoc.Button.Outlined" /><com.google.android.material.button.MaterialButton android:id="@+id/btnForgot" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginTop="14dp" android:text="@string/s1_btnForgot" style="@style/Widget.Material3.Button.TextButton" /></LinearLayout>
</ScrollView>