<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="28dp" android:orientation="vertical">
<ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_fastcoloc_symbol" android:contentDescription="@string/fc_fastcoloc" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="fastcoloc." android:textSize="32sp" android:textColor="@color/fc_violet" android:fontFamily="@font/baloo2" app:fontFamily="@font/baloo2" android:textStyle="bold" android:layout_marginTop="12dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Une place pour toi." android:textSize="14sp" android:textColor="@color/fc_muted" />
<com.google.android.material.imageview.ShapeableImageView android:id="@+id/drawerAvatar" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginTop="28dp" android:scaleType="centerCrop" android:src="@drawable/ic_fastcoloc_symbol" android:importantForAccessibility="no" />
<TextView android:id="@+id/drawerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/fc_plum" android:layout_marginTop="12dp" />
<TextView android:id="@+id/drawerSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/fc_muted" android:layout_marginTop="4dp" />
</LinearLayout>