<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/fc_background" android:scrollbars="none" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fc_modifier_les_coordonnees" android:textAppearance="@style/TextAppearance.FastColoc.Title" android:breakStrategy="balanced" android:textStyle="bold" android:textColor="@color/fc_plum" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fc_prenom" android:textAppearance="@style/TextAppearance.FastColoc.Label" android:layout_marginTop="18dp" android:layout_marginBottom="7dp" android:labelFor="@id/etEditFirstName" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.FastColoc.Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="@string/fc_prenom">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEditFirstName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:minHeight="50dp" android:textSize="15sp" android:textColor="@color/fc_plum" android:fontFamily="sans-serif" android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="14dp" android:paddingBottom="14dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fc_nom" android:textAppearance="@style/TextAppearance.FastColoc.Label" android:layout_marginTop="18dp" android:layout_marginBottom="7dp" android:labelFor="@id/etEditLastName" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.FastColoc.Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="@string/fc_nom">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEditLastName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:minHeight="50dp" android:textSize="15sp" android:textColor="@color/fc_plum" android:fontFamily="sans-serif" android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="14dp" android:paddingBottom="14dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fc_adresse_e_mail" android:textAppearance="@style/TextAppearance.FastColoc.Label" android:layout_marginTop="18dp" android:layout_marginBottom="7dp" android:labelFor="@id/etEditEmail" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.FastColoc.Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="@string/fc_adresse_e_mail">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEditEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:minHeight="50dp" android:textSize="15sp" android:textColor="@color/fc_plum" android:fontFamily="sans-serif" android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="14dp" android:paddingBottom="14dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fc_telephone_8_chiffres" android:textAppearance="@style/TextAppearance.FastColoc.Label" android:layout_marginTop="18dp" android:layout_marginBottom="7dp" android:labelFor="@id/etEditPhone" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.FastColoc.Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="@string/fc_telephone_8_chiffres">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEditPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:maxLength="8" android:minHeight="50dp" android:textSize="15sp" android:textColor="@color/fc_plum" android:fontFamily="sans-serif" android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="14dp" android:paddingBottom="14dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveUserChanges" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/fc_enregistrer_les_modifications" style="@style/Widget.FastColoc.Button" android:minHeight="48dp" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelUserChanges" style="@style/Widget.FastColoc.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/fc_annuler" android:minHeight="48dp" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>