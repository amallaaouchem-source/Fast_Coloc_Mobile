<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/homeScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/fc_cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingTop="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="UNE PLACE POUR TOI" android:textSize="9sp" android:textColor="@color/fc_violet" android:textStyle="bold" android:letterSpacing="0.12" />
                <TextView android:id="@+id/tvWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Salut, bienvenue." android:textAppearance="@style/TextAppearance.FastColoc.Title" android:textSize="22sp" android:lineSpacingExtra="0dp" android:layout_marginTop="2dp" android:fontFamily="@font/baloo2" app:fontFamily="@font/baloo2" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ton prochain chez-toi commence ici." android:textSize="12sp" android:textColor="@color/fc_muted" android:layout_marginTop="2dp" />
            </LinearLayout>
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/heroArt" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:padding="5dp" android:background="@color/fc_white" android:src="@drawable/ic_fastcoloc_symbol" android:scaleType="centerCrop" android:contentDescription="Ouvrir mon profil" android:focusable="true" android:clickable="true" app:shapeAppearanceOverlay="@style/ShapeAppearance.FastColoc.HomePhoto" app:strokeColor="@color/fc_line" app:strokeWidth="1dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginHorizontal="20dp" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_fc_card" android:paddingStart="14dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_fc_search" android:importantForAccessibility="no" />
                <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:hint="Ville, quartier, envie…" android:inputType="text" android:imeOptions="actionSearch" android:singleLine="true" android:textSize="13sp" android:textColor="@color/fc_plum" android:textColorHint="@color/fc_muted" android:background="@null" android:paddingHorizontal="10dp" android:importantForAutofill="no" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnListings" style="@style/Widget.FastColoc.CompactButton" android:layout_width="48dp" android:layout_height="48dp" android:text="" android:contentDescription="Rechercher des annonces" android:padding="0dp" app:strokeWidth="0dp" app:backgroundTint="@android:color/transparent" app:icon="@drawable/ic_fc_arrow" app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="22dp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFilters" style="@style/Widget.FastColoc.Button" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:text="" android:contentDescription="Filtrer les annonces" android:padding="0dp" app:icon="@drawable/ic_fc_filters" app:iconTint="@color/fc_white" app:iconPadding="0dp" app:iconSize="22dp" app:iconGravity="textStart" />
        </LinearLayout>
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="10dp" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="8dp">
            <com.google.android.material.chip.Chip android:id="@+id/chipAll" style="@style/Widget.FastColoc.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tout" android:checked="true" android:checkable="true" app:checkedIconVisible="false" />
            <com.google.android.material.chip.Chip android:id="@+id/chipOffers" style="@style/Widget.FastColoc.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Un logement" android:checkable="true" app:checkedIconVisible="false" />
            <com.google.android.material.chip.Chip android:id="@+id/chipRequests" style="@style/Widget.FastColoc.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Des colocs" android:checkable="true" app:checkedIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnContinue" style="@style/Widget.FastColoc.CompactButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="8dp" android:text="Compléter mon profil" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="À découvrir" android:textAppearance="@style/TextAppearance.FastColoc.Section" android:fontFamily="@font/baloo2" app:fontFamily="@font/baloo2" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSeeAll" style="@style/Widget.FastColoc.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tout voir" app:icon="@drawable/ic_fc_arrow" app:iconSize="16dp" app:iconGravity="end" app:iconTint="@color/fc_violet" />
        </LinearLayout>
        <TextView android:id="@+id/tvRecentState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:text="Les dernières annonces de la communauté." android:textSize="12sp" android:textColor="@color/fc_muted" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/recentProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:indeterminate="true" android:visibility="gone" android:layout_marginTop="8dp" />
        <LinearLayout android:id="@+id/recentSkeleton" android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginHorizontal="20dp" android:layout_marginTop="14dp" android:padding="14dp" android:background="@drawable/bg_fc_card" android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
            <View android:layout_width="match_parent" android:layout_height="145dp" android:background="@drawable/bg_fc_illustration" />
            <View android:layout_width="180dp" android:layout_height="14dp" android:layout_marginTop="16dp" android:background="@color/fc_lilac" />
            <View android:layout_width="110dp" android:layout_height="12dp" android:layout_marginTop="10dp" android:background="@color/fc_lilac" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRecent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:paddingStart="20dp" android:paddingEnd="8dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRetry" style="@style/Widget.FastColoc.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="Actualiser les annonces" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="22dp" android:background="@drawable/bg_fc_home_banner" android:orientation="horizontal" android:padding="18dp" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="La bonne coloc,\nça se partage." android:textAppearance="@style/TextAppearance.FastColoc.Section" android:textColor="@color/fc_cream" android:textSize="23sp" android:fontFamily="@font/baloo2" app:fontFamily="@font/baloo2" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Une chambre libre ou un projet en tête ?" android:textColor="@color/fc_cream" android:textSize="12sp" android:layout_marginTop="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPublish" style="@style/Widget.FastColoc.Button.Coral" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Publier une annonce" android:textSize="12sp" android:layout_marginTop="12dp" android:paddingHorizontal="14dp" />
            </LinearLayout>
            <ImageView android:layout_width="68dp" android:layout_height="68dp" android:layout_marginStart="8dp" android:src="@drawable/ic_fastcoloc_symbol" android:rotation="-8" android:importantForAccessibility="no" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="22dp" android:text="Ton coin à toi" android:textAppearance="@style/TextAppearance.FastColoc.Section" android:fontFamily="@font/baloo2" app:fontFamily="@font/baloo2" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginHorizontal="20dp" android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFavorites" style="@style/Widget.FastColoc.CompactButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:text="Mes favoris" app:icon="@drawable/ic_fc_heart" app:iconSize="18dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnMine" style="@style/Widget.FastColoc.CompactButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Mes annonces" app:icon="@drawable/ic_fc_list" app:iconSize="18dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>