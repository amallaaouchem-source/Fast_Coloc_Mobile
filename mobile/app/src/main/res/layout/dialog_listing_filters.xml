<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_spKind" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <Spinner android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/spKind" android:minHeight="50dp" android:contentDescription="@string/s2_hint_spKind"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_spRegion" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <Spinner android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/spRegion" android:minHeight="50dp" android:contentDescription="@string/s2_hint_spRegion"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_spLocality" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <Spinner android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/spLocality" android:minHeight="50dp" android:contentDescription="@string/s2_hint_spLocality"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etMinRent" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
            <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etMinRent" android:hint="@string/s2_hint_etMinRent" android:inputType="numberDecimal" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etMaxRent" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
            <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etMaxRent" android:hint="@string/s2_hint_etMaxRent" android:inputType="numberDecimal" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etMinCapacity" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
            <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etMinCapacity" android:hint="@string/s2_hint_etMinCapacity" android:inputType="number" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etPropertyFilter" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
            <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etPropertyFilter" android:hint="@string/s2_hint_etPropertyFilter" android:inputType="text" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etRoommateFilter" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
            <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etRoommateFilter" android:hint="@string/s2_hint_etRoommateFilter" android:inputType="text" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etEquipmentFilter" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
            <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etEquipmentFilter" android:hint="@string/s2_hint_etEquipmentFilter" android:inputType="text" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etAvailableFilter" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
            <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etAvailableFilter" android:hint="@string/s2_hint_etAvailableFilter" android:inputType="date" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_spSort" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <Spinner android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/spSort" android:minHeight="50dp" android:contentDescription="@string/s2_hint_spSort"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
