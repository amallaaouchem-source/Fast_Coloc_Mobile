<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_fc_card" android:padding="14dp" android:layout_marginBottom="16dp">
    <com.google.android.material.imageview.ShapeableImageView app:shapeAppearanceOverlay="@style/ShapeAppearance.FastColoc.Photo" android:id="@+id/ivPhoto" android:layout_width="match_parent" android:layout_height="210dp" android:scaleType="centerCrop" android:background="@color/fc_pink" android:contentDescription="@string/s2_photo"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvTitle" android:textSize="23sp" android:maxLines="2" android:ellipsize="end" android:text="@string/s2_tvTitle" android:textAppearance="@style/TextAppearance.FastColoc.Title" android:layout_marginTop="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvPlace" android:text="@string/s2_tvPlace" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvRent" android:textColor="@color/fc_violet" android:textSize="22sp" android:textStyle="bold" android:text="@string/s2_tvRent" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvInfo" android:text="@string/s2_tvInfo" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvStatus" android:text="@string/s2_tvStatus" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
    <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnFavorite" app:icon="@drawable/ic_fc_heart" android:text="@string/s2_btnFavorite" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button.Outlined"/>
</LinearLayout>
