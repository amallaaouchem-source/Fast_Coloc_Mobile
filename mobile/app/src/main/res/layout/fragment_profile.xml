<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/fc_cream" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="240dp" android:background="@drawable/bg_fc_profile_cover">
            <ImageView android:id="@+id/ivProfileAvatar" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_fastcoloc_symbol" android:padding="64dp" android:scaleType="centerInside" android:contentDescription="Ma photo de profil" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="20dp" android:text="MON ESPACE" android:letterSpacing="0.12" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/fc_violet_dark" android:background="@drawable/bg_fc_card" android:paddingHorizontal="12dp" android:paddingVertical="8dp" />
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|end" android:layout_margin="20dp" android:src="@drawable/ic_fastcoloc_symbol" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="-28dp" android:background="@drawable/bg_fc_card" android:padding="20dp" android:orientation="vertical" android:elevation="2dp">
            <View android:layout_width="32dp" android:layout_height="3dp" android:layout_gravity="center_horizontal" android:background="@color/fc_line" android:layout_marginBottom="12dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tvSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ton espace, à ton image." android:textAppearance="@style/TextAppearance.FastColoc.Title" android:textSize="27sp" android:lineSpacingExtra="0dp" android:fontFamily="@font/baloo2" app:fontFamily="@font/baloo2" />
            <TextView android:id="@+id/tvIdentityMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Membre FastColoc" android:textSize="13sp" android:textColor="@color/fc_muted" android:layout_marginTop="2dp" />
            <TextView android:id="@+id/tvProfileStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:background="@drawable/bg_fc_tag" android:text="Mon profil" android:textColor="@color/fc_violet_dark" android:textSize="11sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnShowEdit" style="@style/Widget.FastColoc.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Modifier" android:textSize="13sp" android:layout_marginEnd="5dp" android:contentDescription="Modifier mes informations" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEdit5" style="@style/Widget.FastColoc.CompactButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Mes photos" android:layout_marginStart="5dp" app:icon="@drawable/ic_add_photo" app:iconSize="18dp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnContinue" style="@style/Widget.FastColoc.Button.Coral" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compléter mon inscription" android:visibility="gone" android:layout_marginTop="10dp" />
            <LinearLayout android:id="@+id/editSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEdit1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Identité" style="@style/Widget.FastColoc.Button.Outlined" android:layout_marginTop="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEdit2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Adresse" style="@style/Widget.FastColoc.Button.Outlined" android:layout_marginTop="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEdit3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="À propos de moi" style="@style/Widget.FastColoc.Button.Outlined" android:layout_marginTop="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEdit4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Coordonnées" style="@style/Widget.FastColoc.Button.Outlined" android:layout_marginTop="12dp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/fc_line" android:layout_marginVertical="20dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="À propos de moi" android:textAppearance="@style/TextAppearance.FastColoc.Section" android:fontFamily="@font/baloo2" app:fontFamily="@font/baloo2" />
            <TextView android:id="@+id/tvBiography" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quelques mots pour faire connaissance." android:textAppearance="@style/TextAppearance.FastColoc.Supporting" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/tvLanguages" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Langues à renseigner" android:textColor="@color/fc_violet_dark" android:textSize="12sp" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/bg_fc_note" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/fc_line" android:layout_marginVertical="20dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mes coordonnées" android:textAppearance="@style/TextAppearance.FastColoc.Section" android:fontFamily="@font/baloo2" app:fontFamily="@font/baloo2" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Téléphone" android:textSize="11sp" android:textColor="@color/fc_muted" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/tvPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Non renseigné" android:textSize="15sp" android:textColor="@color/fc_plum" android:textStyle="bold" android:layout_marginTop="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Adresse" android:textSize="11sp" android:textColor="@color/fc_muted" android:layout_marginTop="14dp" />
            <TextView android:id="@+id/tvAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Non renseignée" android:textSize="14sp" android:textColor="@color/fc_plum" android:layout_marginTop="4dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDetails" style="@style/Widget.FastColoc.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Toutes mes informations" android:gravity="start|center_vertical" android:layout_marginTop="8dp" app:icon="@drawable/ic_fc_arrow" app:iconGravity="end" app:iconTint="@color/fc_violet" />
            <TextView android:id="@+id/tvDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/fc_muted" android:textSize="13sp" android:lineSpacingExtra="5dp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="16dp" android:background="@drawable/bg_fc_card" android:padding="20dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ma coloc idéale" android:textAppearance="@style/TextAppearance.FastColoc.Section" android:fontFamily="@font/baloo2" app:fontFamily="@font/baloo2" />
            <TextView android:id="@+id/tvBudgetSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Budget, date et quartiers préférés." android:textAppearance="@style/TextAppearance.FastColoc.Supporting" android:layout_marginTop="6dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnShowPreferences" style="@style/Widget.FastColoc.CompactButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ajuster mes préférences" android:layout_marginTop="14dp" app:icon="@drawable/ic_fc_filters" app:iconSize="18dp" />
            <LinearLayout android:id="@+id/preferencesSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Budget minimum (TND / mois)" android:textColor="@color/fc_plum" android:layout_marginTop="12dp" android:textSize="12sp" android:labelFor="@id/etMinBudget" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMinBudget" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:minHeight="50dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Budget maximum (TND / mois)" android:textColor="@color/fc_plum" android:layout_marginTop="12dp" android:textSize="12sp" android:labelFor="@id/etMaxBudget" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMaxBudget" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:minHeight="50dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Date d’emménagement (facultatif)" android:textColor="@color/fc_plum" android:layout_marginTop="12dp" android:textSize="12sp" android:labelFor="@id/etMoveIn" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMoveIn" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="date" android:minHeight="50dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPlaces" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choisir mes localités" style="@style/Widget.FastColoc.Button.Outlined" android:layout_marginTop="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPreferences" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enregistrer mes préférences" style="@style/Widget.FastColoc.Button.Coral" android:layout_marginTop="12dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="16dp" android:background="@drawable/bg_fc_card" android:padding="8dp" android:orientation="vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRefresh" style="@style/Widget.FastColoc.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Actualiser mon profil" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/fc_line" android:layout_marginHorizontal="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout" style="@style/Widget.FastColoc.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Déconnexion" android:textColor="@color/fc_error" app:icon="@drawable/ic_fc_logout" app:iconTint="@color/fc_error" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>