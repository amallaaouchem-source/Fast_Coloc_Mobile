<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_auth"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.iset.fastcolloc.ui.auth.LoginFragment"
        android:label="Connexion">
        <action
            android:id="@+id/action_login_to_register1"
            app:destination="@id/registerStep1Fragment" />
    </fragment>

    <fragment
        android:id="@+id/registerStep1Fragment"
        android:name="com.iset.fastcolloc.ui.auth.RegisterStep1Fragment"
        android:label="Inscription - Étape 1">
        <action android:id="@+id/action_register1_to_register2" app:destination="@id/registerStep2Fragment" />
    </fragment>
    <fragment
        android:id="@+id/registerStep2Fragment"
        android:name="com.iset.fastcolloc.ui.auth.RegisterStep2Fragment"
        android:label="Inscription - Étape 2">
        <action android:id="@+id/action_register2_to_register3" app:destination="@id/registerStep3Fragment" />
    </fragment>
    <fragment
        android:id="@+id/registerStep3Fragment"
        android:name="com.iset.fastcolloc.ui.auth.RegisterStep3Fragment"
        android:label="Inscription - Étape 3">
        <action android:id="@+id/action_register3_to_register4" app:destination="@id/registerStep4Fragment" />
    </fragment>
    <fragment
        android:id="@+id/registerStep4Fragment"
        android:name="com.iset.fastcolloc.ui.auth.RegisterStep4Fragment"
        android:label="Inscription - Étape 4">
        <action android:id="@+id/action_register4_to_register5" app:destination="@id/registerStep5Fragment" />
    </fragment>
    <fragment
        android:id="@+id/registerStep5Fragment"
        android:name="com.iset.fastcolloc.ui.auth.RegisterStep5Fragment"
        android:label="Inscription - Étape 5">
        <action android:id="@+id/action_register5_to_success" app:destination="@id/registrationSuccessFragment" />
    </fragment>
    <fragment
        android:id="@+id/registrationSuccessFragment"
        android:name="com.iset.fastcolloc.ui.auth.RegistrationSuccessFragment"
        android:label="Compte créé" />
    <fragment android:id="@+id/verifyFragment" android:name="com.iset.fastcolloc.ui.auth.EmailFragment" android:label="Confirmation" />
    <fragment android:id="@+id/forgotFragment" android:name="com.iset.fastcolloc.ui.auth.EmailFragment" android:label="Récupération" />
    <fragment android:id="@+id/resetFragment" android:name="com.iset.fastcolloc.ui.auth.ResetFragment" android:label="Nouveau mot de passe" />
    <fragment android:id="@+id/homeFragment" android:name="com.iset.fastcolloc.ui.auth.HomeFragment" android:label="Accueil" />
    <fragment android:id="@+id/profileFragment" android:name="com.iset.fastcolloc.ui.auth.ProfileFragment" android:label="Mon profil" />
    <fragment android:id="@+id/listingCatalogFragment" android:name="com.iset.fastcolloc.ui.listings.ListingCatalogFragment" android:label="Annonces" />
    <fragment android:id="@+id/listingDetailFragment" android:name="com.iset.fastcolloc.ui.listings.ListingDetailFragment" android:label="La coloc en détail">
        <argument android:name="listingId" app:argType="string" />
    </fragment>
    <fragment android:id="@+id/listingEditorFragment" android:name="com.iset.fastcolloc.ui.listings.ListingEditorFragment" android:label="Mon annonce">
        <argument android:name="listingId" app:argType="string" android:defaultValue="" />
    </fragment>
<fragment android:id="@id/favoritesFragment" android:name="com.iset.fastcolloc.ui.listings.ListingCatalogFragment" android:label="Mes favoris"><argument android:name="mode" app:argType="string" android:defaultValue="favorites" /></fragment>
<fragment android:id="@id/mineListingsFragment" android:name="com.iset.fastcolloc.ui.listings.ListingCatalogFragment" android:label="Mes annonces"><argument android:name="mode" app:argType="string" android:defaultValue="mine" /></fragment>
<fragment android:id="@+id/publicationSuccessFragment" android:name="com.iset.fastcolloc.ui.listings.PublicationSuccessFragment" android:label="Annonce publiée"><argument android:name="listingId" app:argType="string" /><argument android:name="title" app:argType="string" android:defaultValue="" /></fragment></navigation>
